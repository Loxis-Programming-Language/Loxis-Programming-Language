import loxis.collections.list

fun applyTo(value: int, f: fun(int) -> int) -> int {
    return f(value)
}

fun makeCounter() -> fun() -> int {
    var n = 0
    return { n = n + 1; n }
}

fun main() -> int {
    val xs = list<int>()
    xs.push(1); xs.push(2); xs.push(3); xs.push(4); xs.push(5)
    xs.push(6); xs.push(7); xs.push(8); xs.push(9); xs.push(10)

    print("--- trailing lambda pipeline ---")
    val evens = xs.filter { n -> n % 2 == 0 }
    val squared = evens.map { n -> n * n }
    print(squared.get(0))
    print(squared.get(4))

    val total = xs.fold(0) { acc, n -> acc + n }
    print(total)

    val product = xs.fold(1) { acc, n -> acc * n }
    print(product)

    print("--- closures ---")
    val c = makeCounter()
    print(c())
    print(c())
    print(c())

    print(applyTo(41) { x -> x + 1 })

    return 0
}

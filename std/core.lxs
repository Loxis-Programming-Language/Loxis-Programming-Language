use crate::option::Option;

pub enum Ordering {
    Less,
    Equal,
    Greater,
}

pub trait Clone {
    fn clone(&self) -> Self;
}

pub trait Copy {}

pub trait Default {
    fn default() -> Self;
}

pub trait PartialEq<Rhs = Self> {
    fn eq(&self, other: &Rhs) -> bool;
    fn ne(&self, other: &Rhs) -> bool {
        !self.eq(other)
    }
}

pub trait PartialOrd<Rhs = Self> : PartialEq<Rhs> {
    fn partial_cmp(&self, other: &Rhs) -> Option<Ordering>;
}

pub trait Add<Rhs = Self> {
    type Output;
    fn add(self, rhs: Rhs) -> Self::Output;
}

pub trait Sub<Rhs = Self> {
    type Output;
    fn sub(self, rhs: Rhs) -> Self::Output;
}

pub trait Mul<Rhs = Self> {
    type Output;
    fn mul(self, rhs: Rhs) -> Self::Output;
}

pub trait Div<Rhs = Self> {
    type Output;
    fn div(self, rhs: Rhs) -> Self::Output;
}

pub trait Rem<Rhs = Self> {
    type Output;
    fn rem(self, rhs: Rhs) -> Self::Output;
}

pub trait Neg {
    type Output;
    fn neg(self) -> Self::Output;
}

pub trait Not {
    type Output;
    fn not(self) -> Self::Output;
}

pub trait BitAnd<Rhs = Self> {
    type Output;
    fn bitand(self, rhs: Rhs) -> Self::Output;
}

pub trait BitOr<Rhs = Self> {
    type Output;
    fn bitor(self, rhs: Rhs) -> Self::Output;
}

pub trait BitXor<Rhs = Self> {
    type Output;
    fn bitxor(self, rhs: Rhs) -> Self::Output;
}

pub trait Shl<Rhs = Self> {
    type Output;
    fn shl(self, rhs: Rhs) -> Self::Output;
}

pub trait Shr<Rhs = Self> {
    type Output;
    fn shr(self, rhs: Rhs) -> Self::Output;
}

pub trait Deref {
    type Target;
    fn deref(&self) -> &Self::Target;
}

pub trait DerefMut : Deref {
    fn deref_mut(&mut self) -> &mut Self::Target;
}

pub trait Drop {
    fn drop(&mut self);
}

pub trait Sized {}

pub trait Display {
    fn fmt(&self) -> String;
}

// --- i32 ---

impl Clone for i32 {
    fn clone(&self) -> Self { *self }
}

impl Copy for i32 {}

impl PartialEq for i32 {
    fn eq(&self, other: &Self) -> bool { self == other }
}

impl PartialOrd for i32 {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
        if self < other { Some(Ordering::Less) }
        else if self == other { Some(Ordering::Equal) }
        else { Some(Ordering::Greater) }
    }
}

impl Add for i32 {
    type Output = i32;
    fn add(self, rhs: Self) -> Self::Output { self + rhs }
}

impl Sub for i32 {
    type Output = i32;
    fn sub(self, rhs: Self) -> Self::Output { self - rhs }
}

impl Mul for i32 {
    type Output = i32;
    fn mul(self, rhs: Self) -> Self::Output { self * rhs }
}

impl Div for i32 {
    type Output = i32;
    fn div(self, rhs: Self) -> Self::Output { self / rhs }
}

impl Rem for i32 {
    type Output = i32;
    fn rem(self, rhs: Self) -> Self::Output { self % rhs }
}

impl Neg for i32 {
    type Output = i32;
    fn neg(self) -> Self::Output { -self }
}

impl Not for i32 {
    type Output = i32;
    fn not(self) -> Self::Output { !self }
}

impl BitAnd for i32 {
    type Output = i32;
    fn bitand(self, rhs: Self) -> Self::Output { self & rhs }
}

impl BitOr for i32 {
    type Output = i32;
    fn bitor(self, rhs: Self) -> Self::Output { self | rhs }
}

impl BitXor for i32 {
    type Output = i32;
    fn bitxor(self, rhs: Self) -> Self::Output { self ^ rhs }
}

impl Shl for i32 {
    type Output = i32;
    fn shl(self, rhs: Self) -> Self::Output { self << rhs }
}

impl Shr for i32 {
    type Output = i32;
    fn shr(self, rhs: Self) -> Self::Output { self >> rhs }
}


use crate::option::Option;

pub struct Vec<T> {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

impl<T> Vec<T> {
    pub fn new() -> Self { Vec { ptr: alloc(0), len: 0, cap: 0 } }
    pub fn push(&mut self, val: T) { /* stub */ }
    pub fn pop(&mut self) -> Option<T> { /* stub */ None }
    pub fn get(&self, idx: usize) -> Option<&T> { /* stub */ None }
    pub fn len(&self) -> usize { self.len }
    pub fn capacity(&self) -> usize { self.cap }
}

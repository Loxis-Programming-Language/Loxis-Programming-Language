pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    pub fn is_ok(&self) -> bool { match self { Ok(_) => true, Err(_) => false } }
    pub fn is_err(&self) -> bool { !self.is_ok() }
    pub fn unwrap(self) -> T { match self { Ok(v) => v, Err(_) => panic("unwrap on Err") } }
    pub fn unwrap_or(self, def: T) -> T { match self { Ok(v) => v, Err(_) => def } }
    pub fn map<U>(self, f: fn(T) -> U) -> Result<U, E> { match self { Ok(v) => Ok(f(v)), Err(e) => Err(e) } }
}

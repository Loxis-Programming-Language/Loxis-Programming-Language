fun fib25(n: int) -> int {
    if n <= 1 { return n }
    return fib25(n - 1) + fib25(n - 2)
}

fun fib30(n: int) -> int {
    if n <= 1 { return n }
    return fib30(n - 1) + fib30(n - 2)
}

fun arith_10k() -> int {
    var s = 0
    var i = 0
    while i < 10000 {
        s = s + i * 2 - i / 3
        i = i + 1
    }
    return s
}

fun ternary_5k() -> int {
    var s = 0
    var i = 0
    while i < 5000 {
        if i % 2 == 0 { s = s + 1 }
        else { s = s - 1 }
        i = i + 1
    }
    return s
}

fun main() {
    print(fib25(25))
    print(fib30(30))
    print(arith_10k())
    print(ternary_5k())
}

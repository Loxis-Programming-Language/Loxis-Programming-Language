package demo
import loxis.text

// ============================================================
//  Loxis v2 — Interface & chr builtin demo
// ============================================================

// --- Interface with default method ---

interface Greeter {
    fun greet(name: str) -> str {
        return "Hello, " + name
    }
}

class Person : Greeter {
    // Inherits default greet from Greeter
}

class LoudPerson : Greeter {
    override fun greet(name: str) -> str {
        return "HELLO, " + name + "!!!"
    }
}

fun useGreeter(g: Greeter, name: str) -> str {
    return g.greet(name)
}

// --- Arithmetic ---

fun add(a: int, b: int) -> int { return a + b }
fun mul(a: int, b: int) -> int { return a * b }

fun countdown(n: int) -> int {
    print(n)
    if n <= 0 { return 0 }
    return countdown(n - 1)
}

fun fib(n: int) -> int {
    if n <= 1 { return n }
    return fib(n - 1) + fib(n - 2)
}

fun factorial(n: int) -> int {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

// ============================================================
//  Main
// ============================================================

fun main() {
    print("=== Loxis v2 ===")

    // --- Interface defaults ---
    print("--- Interface ---")
    val p = Person()
    print(useGreeter(p, "Alvia"))

    val lp = LoudPerson()
    print(useGreeter(lp, "East"))

    // --- chr builtin ---
    print("--- chr builtin ---")
    print(Text.fromByte(76))     // L
    print(Text.fromByte(111))    // o
    print(Text.fromByte(120))    // x

    // --- Arithmetic ---
    print("--- Arithmetic ---")
    print(add(10, 32))
    print(mul(10, 32))

    // --- Fibonacci ---
    print("--- Fibonacci ---")
    var i = 0
    while i < 10 {
        print(fib(i))
        i = i + 1
    }

    // --- Factorial ---
    print("--- Factorial ---")
    print(factorial(5))
    print(factorial(6))

    // --- Countdown ---
    print("--- Countdown ---")
    countdown(3)

    print("Done.")
}

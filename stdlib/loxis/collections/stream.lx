package loxis.collections.stream

import loxis.collections.list
import loxis.collections.iterator

// ============================================================
//  Stream<T> - fluent wrapper around Iterator<T>
// ============================================================

class Stream<T>(var iter: Iterator<T>) : Iterator<T> {

    override fun next() -> Optional<T> { return this.iter.next() }

    fun forEach(f: fun(T) -> unit) -> unit {
        __loxis_iterForEach<T>(this.iter, f)
    }

    fun count() -> int {
        return __loxis_iterCount<T>(this.iter)
    }

    fun toList() -> list<T> {
        var result = __loxis_listWithCapacity<T>(8)
        var item = this.iter.next()
        while __loxis_optionalHasValue<T>(item) {
            result.push(__loxis_optionalValueOrFail<T>(item))
            item = this.iter.next()
        }
        return result
    }

    fun any(pred: fun(T) -> bool) -> bool {
        return __loxis_iterAny<T>(this.iter, pred)
    }

    fun all(pred: fun(T) -> bool) -> bool {
        return __loxis_iterAll<T>(this.iter, pred)
    }

    fun find(pred: fun(T) -> bool) -> Optional<T> {
        return __loxis_iterFind<T>(this.iter, pred)
    }

    fun filter(pred: fun(T) -> bool) -> Stream<T> { return Stream<T>(__loxis_iterFilter<T>(this.iter, pred)) }
    fun map<U>(f: fun(T) -> U) -> Stream<U> { return Stream<U>(__loxis_iterMap<T, U>(this.iter, f)) }
    fun fold<U>(initial: U, f: fun(U, T) -> U) -> U { return __loxis_iterFold<T, U>(this.iter, initial, f) }
    fun zip<U>(other: Stream<U>) -> Stream<Pair<T, U>> {
        return Stream<Pair<T, U>>(__loxis_iterZip<T, U>(this.iter, other.iter))
    }
    fun take(count: int) -> Stream<T> { return Stream<T>(__loxis_iterTake<T>(this.iter, count)) }
    fun drop(count: int) -> Stream<T> { return Stream<T>(__loxis_iterDrop<T>(this.iter, count)) }
}

// ============================================================
//  Constructors
// ============================================================

fun stream<T>(items: list<T>) -> Stream<T> { return Stream<T>(__loxis_listIter<T>(items)) }
fun stream<T>(iter: Iterator<T>) -> Stream<T> { return Stream<T>(iter) }
fun stream<T>() -> Stream<T> { return Stream<T>(__loxis_emptyIter<T>()) }

fun __loxis_streamMap<T, U>(stream: Stream<T>, f: fun(T) -> U) -> Stream<U> {
    return Stream<U>(__loxis_iterMap<T, U>(stream.iter, f))
}

object Streams {
    fun map<T, U>(stream: Stream<T>, f: fun(T) -> U) -> Stream<U> { return __loxis_streamMap<T, U>(stream, f) }
}

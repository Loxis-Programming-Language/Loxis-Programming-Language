package loxis.collections.iterator

import loxis.collections.list
import loxis.option

// ============================================================
//  Iterator<T> interface
// ============================================================

interface Iterator<T> {
    fun next() -> Optional<T>
}

// ============================================================
//  Simple iterator that always returns null
// ============================================================

class EmptyIterator<T>() : Iterator<T> {
    override fun next() -> Optional<T> {
        return __loxis_optionalEmpty<T>()
    }
}

fun __loxis_emptyIter<T>() -> EmptyIterator<T> {
    return EmptyIterator<T>()
}

class ListIterator<T>(var items: list<T>, var index: int) : Iterator<T> {
    override fun next() -> Optional<T> {
        if this.index >= this.items.len {
            return __loxis_optionalEmpty<T>()
        }
        val value = this.items.get(this.index)
        this.index += 1
        return __loxis_optionalValue<T>(value)
    }
}

fun __loxis_listIter<T>(items: list<T>) -> ListIterator<T> {
    return ListIterator<T>(items, 0)
}

fun __loxis_iterForEach<T>(iter: Iterator<T>, f: fun(T) -> unit) -> unit {
    var item = iter.next()
    while __loxis_optionalHasValue<T>(item) {
        f(__loxis_optionalValueOrFail<T>(item))
        item = iter.next()
    }
}

fun __loxis_iterCount<T>(iter: Iterator<T>) -> int {
    var count = 0
    var item = iter.next()
    while __loxis_optionalHasValue<T>(item) {
        count += 1
        item = iter.next()
    }
    return count
}

fun __loxis_iterAny<T>(iter: Iterator<T>, pred: fun(T) -> bool) -> bool {
    var item = iter.next()
    while __loxis_optionalHasValue<T>(item) {
        if pred(__loxis_optionalValueOrFail<T>(item)) {
            return true
        }
        item = iter.next()
    }
    return false
}

fun __loxis_iterAll<T>(iter: Iterator<T>, pred: fun(T) -> bool) -> bool {
    var item = iter.next()
    while __loxis_optionalHasValue<T>(item) {
        if !pred(__loxis_optionalValueOrFail<T>(item)) {
            return false
        }
        item = iter.next()
    }
    return true
}

fun __loxis_iterFind<T>(iter: Iterator<T>, pred: fun(T) -> bool) -> Optional<T> {
    var item = iter.next()
    while __loxis_optionalHasValue<T>(item) {
        val value = __loxis_optionalValueOrFail<T>(item)
        if pred(value) {
            return item
        }
        item = iter.next()
    }
    return __loxis_optionalEmpty<T>()
}

class MapIterator<T, U>(val source: Iterator<T>, val transform: fun(T) -> U) : Iterator<U> {
    override fun next() -> Optional<U> {
        return __loxis_optionalMap<T, U>(this.source.next(), this.transform)
    }
}

class FilterIterator<T>(val source: Iterator<T>, val predicate: fun(T) -> bool) : Iterator<T> {
    override fun next() -> Optional<T> {
        var item = this.source.next()
        while __loxis_optionalHasValue<T>(item) {
            if this.predicate(__loxis_optionalValueOrFail<T>(item)) { return item }
            item = this.source.next()
        }
        return __loxis_optionalEmpty<T>()
    }
}

class TakeIterator<T>(val source: Iterator<T>, var remaining: int) : Iterator<T> {
    override fun next() -> Optional<T> {
        if this.remaining == 0 { return __loxis_optionalEmpty<T>() }
        val item = this.source.next()
        if __loxis_optionalIsEmpty<T>(item) { this.remaining = 0 }
        else { this.remaining -= 1 }
        return item
    }
}

class DropIterator<T>(val source: Iterator<T>, var remaining: int) : Iterator<T> {
    override fun next() -> Optional<T> {
        while this.remaining > 0 {
            this.remaining -= 1
            if __loxis_optionalIsEmpty<T>(this.source.next()) {
                this.remaining = 0
                return __loxis_optionalEmpty<T>()
            }
        }
        return this.source.next()
    }
}

class Pair<A, B>(val first: A, val second: B) {}

class ZipIterator<A, B>(val left: Iterator<A>, val right: Iterator<B>, var done: bool) : Iterator<Pair<A, B>> {
    override fun next() -> Optional<Pair<A, B>> {
        if this.done { return __loxis_optionalEmpty<Pair<A, B>>() }
        val a = this.left.next()
        if __loxis_optionalIsEmpty<A>(a) { this.done = true; return __loxis_optionalEmpty<Pair<A, B>>() }
        val b = this.right.next()
        if __loxis_optionalIsEmpty<B>(b) { this.done = true; return __loxis_optionalEmpty<Pair<A, B>>() }
        return __loxis_optionalValue<Pair<A, B>>(Pair<A, B>(__loxis_optionalValueOrFail<A>(a), __loxis_optionalValueOrFail<B>(b)))
    }
}

fun __loxis_iterMap<T, U>(source: Iterator<T>, f: fun(T) -> U) -> MapIterator<T, U> { return MapIterator<T, U>(source, f) }
fun __loxis_iterFilter<T>(source: Iterator<T>, f: fun(T) -> bool) -> FilterIterator<T> { return FilterIterator<T>(source, f) }
fun __loxis_iterTake<T>(source: Iterator<T>, count: int) -> TakeIterator<T> {
    require(count >= 0, "negative iterator count")
    return TakeIterator<T>(source, count)
}
fun __loxis_iterDrop<T>(source: Iterator<T>, count: int) -> DropIterator<T> {
    require(count >= 0, "negative iterator count")
    return DropIterator<T>(source, count)
}
fun __loxis_iterZip<A, B>(left: Iterator<A>, right: Iterator<B>) -> ZipIterator<A, B> {
    return ZipIterator<A, B>(left, right, false)
}
fun __loxis_iterFold<T, U>(iter: Iterator<T>, initial: U, f: fun(U, T) -> U) -> U {
    var total = initial
    var item = iter.next()
    while __loxis_optionalHasValue<T>(item) {
        total = f(total, __loxis_optionalValueOrFail<T>(item))
        item = iter.next()
    }
    return total
}
fun __loxis_iterToList<T>(iter: Iterator<T>) -> list<T> {
    val out = __loxis_listWithCapacity<T>(8)
    var item = iter.next()
    while __loxis_optionalHasValue<T>(item) {
        out.push(__loxis_optionalValueOrFail<T>(item))
        item = iter.next()
    }
    return out
}

object Iter {
    fun empty<T>() -> EmptyIterator<T> { return __loxis_emptyIter<T>() }
    fun fromList<T>(items: list<T>) -> ListIterator<T> { return __loxis_listIter<T>(items) }
    fun forEach<T>(iter: Iterator<T>, f: fun(T) -> unit) -> unit { return __loxis_iterForEach<T>(iter, f) }
    fun count<T>(iter: Iterator<T>) -> int { return __loxis_iterCount<T>(iter) }
    fun any<T>(iter: Iterator<T>, pred: fun(T) -> bool) -> bool { return __loxis_iterAny<T>(iter, pred) }
    fun all<T>(iter: Iterator<T>, pred: fun(T) -> bool) -> bool { return __loxis_iterAll<T>(iter, pred) }
    fun find<T>(iter: Iterator<T>, pred: fun(T) -> bool) -> Optional<T> { return __loxis_iterFind<T>(iter, pred) }
    fun map<T, U>(source: Iterator<T>, f: fun(T) -> U) -> MapIterator<T, U> { return __loxis_iterMap<T, U>(source, f) }
    fun filter<T>(source: Iterator<T>, f: fun(T) -> bool) -> FilterIterator<T> { return __loxis_iterFilter<T>(source, f) }
    fun take<T>(source: Iterator<T>, count: int) -> TakeIterator<T> { return __loxis_iterTake<T>(source, count) }
    fun drop<T>(source: Iterator<T>, count: int) -> DropIterator<T> { return __loxis_iterDrop<T>(source, count) }
    fun zip<A, B>(left: Iterator<A>, right: Iterator<B>) -> ZipIterator<A, B> { return __loxis_iterZip<A, B>(left, right) }
    fun fold<T, U>(iter: Iterator<T>, initial: U, f: fun(U, T) -> U) -> U { return __loxis_iterFold<T, U>(iter, initial, f) }
    fun toList<T>(iter: Iterator<T>) -> list<T> { return __loxis_iterToList<T>(iter) }
}

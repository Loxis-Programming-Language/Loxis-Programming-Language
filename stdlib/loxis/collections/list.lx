package loxis.collections

import loxis.option

class list<T>() {
    var buffer: int = __loxis_arrayNew(0)
    var len: int = 0
    var cap: int = 0
    fun size() -> int {
        return this.len
    }

    fun capacity() -> int {
        return this.cap
    }

    fun get(index: int) -> T {
        require(index >= 0 && index < this.len, "list index out of bounds")
        return __loxis_arrayGet(this.buffer, index)
    }

    fun set(index: int, value: T) -> unit {
        require(index >= 0 && index < this.len, "list index out of bounds")
        __loxis_arraySet(this.buffer, index, value)
    }

    fun isEmpty() -> bool { return this.len == 0 }

    fun clear() -> unit {
        var i = 0
        while i < this.len {
            hset(this.buffer, 9 + i * 9, null)
            i += 1
        }
        this.len = 0
    }

    fun insert(index: int, value: T) -> unit {
        require(index >= 0 && index <= this.len, "list index out of bounds")
        this.push(value)
        var i = this.len - 1
        while i > index {
            this.set(i, this.get(i - 1))
            i -= 1
        }
        this.set(index, value)
    }

    fun removeAt(index: int) -> T {
        val value = this.get(index)
        var i = index
        while i + 1 < this.len {
            this.set(i, this.get(i + 1))
            i += 1
        }
        this.len -= 1
        hset(this.buffer, 9 + this.len * 9, null)
        return value
    }

    fun pop() -> Optional<T> {
        if this.len == 0 { return __loxis_optionalEmpty<T>() }
        return __loxis_optionalValue<T>(this.removeAt(this.len - 1))
    }

    fun push(value: T) -> unit {
        if this.len >= this.cap {
            require(this.cap <= 238609293, "list capacity overflow")
            var nextCap = this.cap * 2
            if nextCap <= 0 {
                nextCap = 1
            }

            val next = __loxis_arrayNew(nextCap)
            var i = 0
            while i < this.len {
                __loxis_arraySet(next, i, __loxis_arrayGet(this.buffer, i))
                i += 1
            }

            __loxis_arrayFree(this.buffer)
            this.buffer = next
            this.cap = nextCap
        }

        __loxis_arraySet(this.buffer, this.len, value)
        this.len += 1
    }

    fun forEach(f: fun(T) -> unit) -> unit {
        var i = 0
        while i < this.len { f(this.get(i)); i += 1 }
    }

    fun map<U>(f: fun(T) -> U) -> list<U> {
        val out = __loxis_listWithCapacity<U>(this.len)
        var i = 0
        while i < this.len { out.push(f(this.get(i))); i += 1 }
        return out
    }

    fun filter(pred: fun(T) -> bool) -> list<T> {
        val out = __loxis_listWithCapacity<T>(this.len)
        var i = 0
        while i < this.len {
            val value = this.get(i)
            if pred(value) { out.push(value) }
            i += 1
        }
        return out
    }

    fun fold<U>(initial: U, f: fun(U, T) -> U) -> U {
        var acc = initial
        var i = 0
        while i < this.len { acc = f(acc, this.get(i)); i += 1 }
        return acc
    }

    fun count(pred: fun(T) -> bool) -> int {
        var total = 0
        var i = 0
        while i < this.len { if pred(this.get(i)) { total += 1 }; i += 1 }
        return total
    }

    fun any(pred: fun(T) -> bool) -> bool {
        var i = 0
        while i < this.len { if pred(this.get(i)) { return true }; i += 1 }
        return false
    }

    fun all(pred: fun(T) -> bool) -> bool {
        var i = 0
        while i < this.len { if !pred(this.get(i)) { return false }; i += 1 }
        return true
    }

    // Worth having separately from `any`: it needs no closure allocation, and
    // it is the operation every hand-rolled sequence scan in a demo reaches for.
    fun contains(value: T) -> bool {
        var i = 0
        while i < this.len {
            if this.get(i) == value { return true }
            i += 1
        }
        return false
    }

    fun find(pred: fun(T) -> bool) -> Optional<T> {
        var i = 0
        while i < this.len {
            val value = this.get(i)
            if pred(value) { return __loxis_optionalValue<T>(value) }
            i += 1
        }
        return __loxis_optionalEmpty<T>()
    }

    fun first() -> Optional<T> {
        if this.len == 0 { return __loxis_optionalEmpty<T>() }
        return __loxis_optionalValue<T>(this.get(0))
    }

    fun lastOrNull() -> Optional<T> {
        if this.len == 0 { return __loxis_optionalEmpty<T>() }
        return __loxis_optionalValue<T>(this.get(this.len - 1))
    }

    fun sortBy(before: fun(T, T) -> bool) -> unit {
        __loxis_listSortBy<T>(this, before)
    }

    // ---- index-aware forms ----
    //
    // `mapIndexed`/`filterIndexed`/`forEachIndexed` pass the position first, as
    // in Kotlin: `{ i, value -> ... }`.

    fun forEachIndexed(f: fun(int, T) -> unit) -> unit {
        var i = 0
        while i < this.len { f(i, this.get(i)); i += 1 }
    }

    fun mapIndexed<U>(f: fun(int, T) -> U) -> list<U> {
        val out = __loxis_listWithCapacity<U>(this.len)
        var i = 0
        while i < this.len { out.push(f(i, this.get(i))); i += 1 }
        return out
    }

    fun filterIndexed(pred: fun(int, T) -> bool) -> list<T> {
        val out = __loxis_listWithCapacity<T>(this.len)
        var i = 0
        while i < this.len {
            val value = this.get(i)
            if pred(i, value) { out.push(value) }
            i += 1
        }
        return out
    }

    // ---- reshaping ----

    fun flatMap<U>(f: fun(T) -> list<U>) -> list<U> {
        val out = list<U>()
        var i = 0
        while i < this.len {
            val inner = f(this.get(i))
            var j = 0
            while j < inner.size() {
                out.push(inner.get(j))
                j += 1
            }
            i += 1
        }
        return out
    }


    // ---- selection ----
    //
    // Both are quadratic: they scan what they have kept so far. Fine for the
    // sizes this runs at, and it keeps them closure-free.

    fun distinct() -> list<T> {
        val out = list<T>()
        var i = 0
        while i < this.len {
            val value = this.get(i)
            var seen = false
            var j = 0
            while j < out.size() {
                if out.get(j) == value { seen = true }
                j += 1
            }
            if !seen { out.push(value) }
            i += 1
        }
        return out
    }

    fun distinctBy<K>(f: fun(T) -> K) -> list<T> {
        val keys = list<K>()
        val out = list<T>()
        var i = 0
        while i < this.len {
            val value = this.get(i)
            val key = f(value)
            var seen = false
            var j = 0
            while j < keys.size() {
                if keys.get(j) == key { seen = true }
                j += 1
            }
            if !seen {
                keys.push(key)
                out.push(value)
            }
            i += 1
        }
        return out
    }

    // ---- search ----

    // -1 when nothing matches, like indexOf.
    fun indexOfFirst(pred: fun(T) -> bool) -> int {
        var i = 0
        while i < this.len {
            if pred(this.get(i)) { return i }
            i += 1
        }
        return -1
    }

    fun indexOfLast(pred: fun(T) -> bool) -> int {
        var i = this.len - 1
        while i >= 0 {
            if pred(this.get(i)) { return i }
            i -= 1
        }
        return -1
    }

    fun none(pred: fun(T) -> bool) -> bool {
        return !this.any(pred)
    }

    // Unlike `fold` there is no initial value, so an empty list has no answer
    // to give; use fold for that case.
    fun reduce(f: fun(T, T) -> T) -> T {
        require(this.len > 0, "reduce on an empty list")
        var acc = this.get(0)
        var i = 1
        while i < this.len { acc = f(acc, this.get(i)); i += 1 }
        return acc
    }

    // ---- slicing ----
    //
    // Out-of-range counts clamp rather than fail, as in Kotlin.

    fun drop(count: int) -> list<T> {
        require(count >= 0, "negative drop count")
        val start = __loxis_min(count, this.len)
        val out = __loxis_listWithCapacity<T>(this.len - start)
        var i = start
        while i < this.len { out.push(this.get(i)); i += 1 }
        return out
    }

    fun dropLast(count: int) -> list<T> {
        require(count >= 0, "negative drop count")
        return this.take(__loxis_max(0, this.len - count))
    }

    fun takeLast(count: int) -> list<T> {
        require(count >= 0, "negative take count")
        return this.drop(__loxis_max(0, this.len - count))
    }

    fun takeWhile(pred: fun(T) -> bool) -> list<T> {
        val out = list<T>()
        var i = 0
        while i < this.len {
            if !pred(this.get(i)) { return out }
            out.push(this.get(i))
            i += 1
        }
        return out
    }

    fun dropWhile(pred: fun(T) -> bool) -> list<T> {
        var i = 0
        while i < this.len {
            if !pred(this.get(i)) { break }
            i += 1
        }
        return this.drop(i)
    }

    fun take(count: int) -> list<T> {
        require(count >= 0, "negative take count")
        val limit = __loxis_min(count, this.len)
        val out = __loxis_listWithCapacity<T>(limit)
        var i = 0
        while i < limit { out.push(this.get(i)); i += 1 }
        return out
    }

    fun append(other: list<T>) -> list<T> {
        val out = __loxis_listWithCapacity<T>(this.len + other.size())
        var i = 0
        while i < this.len { out.push(this.get(i)); i += 1 }
        i = 0
        while i < other.size() { out.push(other.get(i)); i += 1 }
        return out
    }

    fun reverse() -> unit {
        var left = 0
        var right = this.len - 1
        while left < right {
            val value = this.get(left)
            this.set(left, this.get(right))
            this.set(right, value)
            left += 1
            right -= 1
        }
    }

    fun reversed() -> list<T> {
        val out = __loxis_listWithCapacity<T>(this.len)
        var i = this.len - 1
        while i >= 0 { out.push(this.get(i)); i -= 1 }
        return out
    }
}

fun __loxis_listWithCapacity<T>(capacity: int) -> list<T> {
    val storage = __loxis_arrayNew(capacity)
    val out = list<T>()
    out.buffer = storage
    out.cap = capacity
    return out
}


fun __loxis_listSortBy<T>(items: list<T>, before: fun(T, T) -> bool) -> unit {
    var i = 0
    while i < items.size() {
        var best = i
        var j = i + 1
        while j < items.size() {
            if before(items.get(j), items.get(best)) {
                best = j
            }
            j += 1
        }

        if best != i {
            val a = items.get(i)
            val b = items.get(best)
            items.set(i, b)
            items.set(best, a)
        }
        i += 1
    }
}


// A trailing shorter chunk is kept, matching Kotlin.
//
// This is a free function rather than a list method on purpose: a method on a
// generic class whose signature nests the class's own parameter inside another
// generic -- `fun chunked() -> list<list<T>>` -- makes monomorphization recurse
// without bound, and the compiler hangs. The same signature as a free function
// is fine.
fun __loxis_chunked<T>(items: list<T>, size: int) -> list<list<T>> {
    require(size > 0, "chunk size must be positive")
    val out = list<list<T>>()
    var i = 0
    while i < items.size() {
        val chunk = list<T>()
        var j = i
        while j < items.size() && j < i + size {
            chunk.push(items.get(j))
            j += 1
        }
        out.push(chunk)
        i += size
    }
    return out
}

// Free-function mirrors of the list methods above, matching the rest of this
// file. Each just forwards so a call reads either way.


// Cannot be a method: `this` would have to be `list<list<U>>`, and there is no
// way to declare a method on one particular instantiation.
fun __loxis_flatten<U>(items: list<list<U>>) -> list<U> {
    val out = list<U>()
    var i = 0
    while i < items.size() {
        val inner = items.get(i)
        var j = 0
        while j < inner.size() {
            out.push(inner.get(j))
            j += 1
        }
        i += 1
    }
    return out
}

object Lists {
    fun withCapacity<T>(capacity: int) -> list<T> { return __loxis_listWithCapacity<T>(capacity) }
    fun chunked<T>(items: list<T>, size: int) -> list<list<T>> { return __loxis_chunked<T>(items, size) }
    fun flatten<U>(items: list<list<U>>) -> list<U> { return __loxis_flatten<U>(items) }
}

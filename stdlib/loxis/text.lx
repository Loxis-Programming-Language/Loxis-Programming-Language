package loxis.text

import loxis.collections.list
import loxis.result

fun len(value: str) -> int {
    return strlen(value)
}

fun concat(a: str, b: str) -> str {
    return a + b
}

fun parseInt(value: str) -> int {
    return s2i(value)
}

fun intToString(value: int) -> str {
    return i2s(value)
}

fun toString(value: int) -> str { return intToString(value) }

fun charCodeAt(value: str, index: int) -> int {
    return strchar(value, index)
}

fun slice(value: str, start: int, count: int) -> str {
    return strslice(value, start, count)
}

fun indexOf(value: str, needle: str) -> int {
    return strindexof(value, needle)
}

fun contains(value: str, needle: str) -> bool {
    return indexOf(value, needle) >= 0
}

// Strict signed 64-bit decimal parsing: no whitespace or trailing characters.
fun tryParseInt(value: str) -> Result<int, str> {
    val n = strlen(value)
    if n == 0 { return resultFailure<int, str>("empty integer") }
    var i = 0
    var negative = false
    val first = strchar(value, 0)
    if first == 45 || first == 43 {
        negative = first == 45
        i = 1
    }
    if i == n { return resultFailure<int, str>("missing digits") }
    var limit = -9223372036854775807
    if negative { limit -= 1 }
    val threshold = limit / 10
    var total = 0
    while i < n {
        val digit = strchar(value, i) - 48
        if digit < 0 || digit > 9 { return resultFailure<int, str>("invalid digit") }
        if total < threshold { return resultFailure<int, str>("integer overflow") }
        total *= 10
        if total < limit + digit { return resultFailure<int, str>("integer overflow") }
        total -= digit
        i += 1
    }
    if negative { return resultSuccess<int, str>(total) }
    return resultSuccess<int, str>(-total)
}

fun tryParseDouble(value: str) -> Result<double, str> {
    if nativeValidDouble(value) == 0 { return resultFailure<double, str>("invalid floating-point number") }
    return resultSuccess<double, str>(nativeParseDouble(value))
}

fun doubleToString(value: double) -> str { return nativeDoubleString(value) }

fun startsWith(value: str, prefix: str) -> bool {
    return strlen(prefix) <= strlen(value) && strslice(value, 0, strlen(prefix)) == prefix
}

fun endsWith(value: str, suffix: str) -> bool {
    val n = strlen(suffix)
    return n <= strlen(value) && strslice(value, strlen(value) - n, n) == suffix
}

fun isAsciiWhitespace(code: int) -> bool {
    return code == 32 || (code >= 9 && code <= 13)
}

fun trim(value: str) -> str {
    var begin = 0
    var end = strlen(value)
    while begin < end && isAsciiWhitespace(strchar(value, begin)) { begin += 1 }
    while end > begin && isAsciiWhitespace(strchar(value, end - 1)) { end -= 1 }
    return strslice(value, begin, end - begin)
}

// Preserves empty fields, including a trailing empty field.
fun splitText(value: str, separator: str) -> list<str> {
    require(strlen(separator) > 0, "split separator must not be empty")
    val out = listWithCapacity<str>(4)
    var begin = 0
    var i = 0
    val n = strlen(value)
    val width = strlen(separator)
    while i + width <= n {
        if strslice(value, i, width) == separator {
            out.push(strslice(value, begin, i - begin))
            i += width
            begin = i
        } else { i += 1 }
    }
    out.push(strslice(value, begin, n - begin))
    return out
}

fun split(value: str, separator: str) -> list<str> { return splitText(value, separator) }

fun join(values: list<str>, separator: str) -> str {
    var out = ""
    var i = 0
    while i < values.size() {
        if i > 0 { out = out + separator }
        out = out + values.get(i)
        i += 1
    }
    return out
}

fun replace(value: str, needle: str, replacement: str) -> str {
    return join(splitText(value, needle), replacement)
}

// Encodes one Unicode scalar as UTF-8. chr itself is a byte operation.
fun encodeCodePoint(code: int) -> str {
    require(code >= 0 && code <= 1114111 && (code < 55296 || code > 57343), "invalid Unicode scalar")
    if code < 128 { return chr(code) }
    if code < 2048 { return chr(192 + code / 64) + chr(128 + code % 64) }
    if code < 65536 {
        return chr(224 + code / 4096) + chr(128 + code / 64 % 64) + chr(128 + code % 64)
    }
    return chr(240 + code / 262144) + chr(128 + code / 4096 % 64) + chr(128 + code / 64 % 64) + chr(128 + code % 64)
}

fun decodeCodePoints(value: str) -> Result<list<int>, str> {
    val out = listWithCapacity<int>(8)
    var i = 0
    val n = strlen(value)
    while i < n {
        val first = strchar(value, i)
        var width = 1
        var code = first
        var minimum = 0
        if first >= 194 && first <= 223 { width = 2; code = first - 192; minimum = 128 }
        else if first >= 224 && first <= 239 { width = 3; code = first - 224; minimum = 2048 }
        else if first >= 240 && first <= 244 { width = 4; code = first - 240; minimum = 65536 }
        else if first >= 128 { return resultFailure<list<int>, str>("invalid UTF-8 leading byte") }
        if i + width > n { return resultFailure<list<int>, str>("truncated UTF-8") }
        var j = 1
        while j < width {
            val b = strchar(value, i + j)
            if b < 128 || b > 191 { return resultFailure<list<int>, str>("invalid UTF-8 continuation") }
            code = code * 64 + b - 128
            j += 1
        }
        if code < minimum || code > 1114111 || (code >= 55296 && code <= 57343) {
            return resultFailure<list<int>, str>("invalid Unicode scalar")
        }
        out.push(code)
        i += width
    }
    return resultSuccess<list<int>, str>(out)
}

fun codePoints(value: str) -> Result<list<int>, str> { return decodeCodePoints(value) }

fun fromCodePoint(code: int) -> str { return encodeCodePoint(code) }

fun str.length() -> int { return len(this) }
fun str.split(separator: str) -> list<str> { return splitText(this, separator) }
fun str.replace(needle: str, replacement: str) -> str { return join(splitText(this, needle), replacement) }
fun str.trim() -> str { return trim(this) }
fun str.startsWith(prefix: str) -> bool { return startsWith(this, prefix) }
fun str.endsWith(suffix: str) -> bool { return endsWith(this, suffix) }
fun str.contains(needle: str) -> bool { return contains(this, needle) }
fun str.indexOf(needle: str) -> int { return indexOf(this, needle) }
fun str.slice(start: int, count: int) -> str { return slice(this, start, count) }
fun str.codePoints() -> Result<list<int>, str> { return decodeCodePoints(this) }
fun str.toIntResult() -> Result<int, str> { return tryParseInt(this) }
fun str.toDoubleResult() -> Result<double, str> { return tryParseDouble(this) }
fun int.toString() -> str { return intToString(this) }
fun double.toString() -> str { return doubleToString(this) }

// Splits on ASCII whitespace and discards empty fields.
fun str.words() -> list<str> {
    val out = listWithCapacity<str>(8)
    var start = -1
    var i = 0
    while i < strlen(this) {
        if isAsciiWhitespace(strchar(this, i)) {
            if start >= 0 {
                out.push(strslice(this, start, i - start))
                start = -1
            }
        } else if start < 0 {
            start = i
        }
        i += 1
    }
    if start >= 0 { out.push(strslice(this, start, strlen(this) - start)) }
    return out
}

object Unicode {
    fun fromCodePoint(code: int) -> str { return encodeCodePoint(code) }
}

package loxis.fs

import loxis.fileio


// Removes empty directories only.

fun __loxis_listDirectory(path: str) -> Result<list<str>, str> {
    val n = nativeListDirectory(path)
    if n < 0 { return __loxis_resultFailure<list<str>, str>(nativeIoError()) }
    val entries = __loxis_listWithCapacity<str>(n)
    var i = 0
    while i < n { entries.push(nativeDirectoryEntry(i)); i += 1 }
    return __loxis_resultSuccess<list<str>, str>(entries)
}

object Files {
    fun isDirectory(path: str) -> bool { return nativeIsDirectory(path) != 0 }
    fun createDirectories(path: str) -> Result<bool, str> {
        if nativeCreateDirectories(path) == 0 { return __loxis_resultFailure<bool, str>(nativeIoError()) }
        return __loxis_resultSuccess<bool, str>(true)
    }
    fun removeDirectory(path: str) -> Result<bool, str> {
        if nativeRemoveDirectory(path) == 0 { return __loxis_resultFailure<bool, str>(nativeIoError()) }
        return __loxis_resultSuccess<bool, str>(true)
    }
    fun entries(path: str) -> Result<list<str>, str> { return __loxis_listDirectory(path) }
}

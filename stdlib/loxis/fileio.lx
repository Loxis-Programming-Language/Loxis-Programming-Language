package loxis.fileio

import loxis.result
import loxis.collections.list

// Legacy wrappers retain their original result types.
fun __loxis_readText(path: str) -> str { return nativeFileReadText(path) }
fun __loxis_writeText(path: str, content: str) -> int { return nativeFileWriteText(path, content) }
fun __loxis_appendText(path: str, content: str) -> int { return nativeFileAppendText(path, content) }


fun __loxis_tryReadText(path: str) -> Result<str, str> {
    val content = nativeTryReadText(path)
    if content == null { return __loxis_resultFailure<str, str>(nativeIoError()) }
    return __loxis_resultSuccess<str, str>(content!!)
}

fun __loxis_tryWriteText(path: str, content: str) -> Result<int, str> {
    if __loxis_writeText(path, content) == 0 { return __loxis_resultFailure<int, str>("cannot write file: " + path) }
    return __loxis_resultSuccess<int, str>(strlen(content))
}

fun __loxis_tryAppendText(path: str, content: str) -> Result<int, str> {
    if __loxis_appendText(path, content) == 0 { return __loxis_resultFailure<int, str>("cannot append file: " + path) }
    return __loxis_resultSuccess<int, str>(strlen(content))
}


object File {
    fun readText(path: str) -> Result<str, str> { return __loxis_tryReadText(path) }
    fun writeText(path: str, content: str) -> Result<int, str> { return __loxis_tryWriteText(path, content) }
    fun appendText(path: str, content: str) -> Result<int, str> { return __loxis_tryAppendText(path, content) }
    fun readBytes(path: str) -> Result<list<int>, str> {
        val content = nativeTryReadText(path)
        if content == null { return __loxis_resultFailure<list<int>, str>(nativeIoError()) }
        val text = content!!
        val bytes = __loxis_listWithCapacity<int>(strlen(text))
        var i = 0
        while i < strlen(text) { bytes.push(strchar(text, i)); i += 1 }
        return __loxis_resultSuccess<list<int>, str>(bytes)
    }
    fun writeBytes(path: str, bytes: list<int>) -> Result<int, str> {
        var content = ""
        var i = 0
        while i < bytes.size() {
            val byte = bytes.get(i)
            if byte < 0 || byte > 255 { return __loxis_resultFailure<int, str>("byte out of range") }
            content = content + chr(byte)
            i += 1
        }
        return __loxis_tryWriteText(path, content)
    }
    fun exists(path: str) -> bool { return nativeFileExists(path) != 0 }
    fun remove(path: str) -> bool { return nativeFileRemove(path) != 0 }
}

package loxis.fileio

fun readText(path: str) -> str {
    return nativeFileReadText(path)
}

fun writeText(path: str, content: str) -> int {
    return nativeFileWriteText(path, content)
}

fun appendText(path: str, content: str) -> int {
    return nativeFileAppendText(path, content)
}

fun removeFile(path: str) -> int {
    return nativeFileRemove(path)
}

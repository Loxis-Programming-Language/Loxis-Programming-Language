package loxis.io

import loxis.fileio
import loxis.option

fun readChar() -> int { return syscall(0) }
fun writeChar(c: int) -> unit {
    require(c >= 0 && c <= 255, "byte out of range")
    write(chr(c))
}

// LF terminates a line; an immediately preceding CR is removed.
// EOF is Empty, while a blank line is Value("").
fun readLineOptional() -> Optional<str> {
    var c = readChar()
    if c < 0 { return optionalEmpty<str>() }
    var line = ""
    while c >= 0 && c != 10 {
        line = line + chr(c)
        c = readChar()
    }
    val n = strlen(line)
    if c == 10 && n > 0 && strchar(line, n - 1) == 13 {
        line = strslice(line, 0, n - 1)
    }
    return optionalValue<str>(line)
}

fun readLine() -> str { return optionalGetOrElse<str>(readLineOptional(), "") }

fun readAll() -> str {
    var out = ""
    var c = readChar()
    while c >= 0 { out = out + chr(c); c = readChar() }
    return out
}

fun readLines() -> list<str> {
    val out = listWithCapacity<str>(8)
    var item = readLineOptional()
    while optionalHasValue<str>(item) {
        out.push(optionalValueOrFail<str>(item))
        item = readLineOptional()
    }
    return out
}

fun writeLine(value: str) -> unit { write(value); write(chr(10)) }
fun remove(path: str) -> int { return removeFile(path) }

fun readLines(path: str) -> list<str> {
    val content = readText(path)
    val out = listWithCapacity<str>(8)
    var start = 0
    var i = 0
    while i < strlen(content) {
        if strchar(content, i) == 10 {
            var end = i
            if end > start && strchar(content, end - 1) == 13 { end -= 1 }
            out.push(strslice(content, start, end - start))
            start = i + 1
        }
        i += 1
    }
    if start < i { out.push(strslice(content, start, i - start)) }
    return out
}

fun writeLines(path: str, lines: list<str>) -> int {
    var content = ""
    var i = 0
    while i < lines.size() {
        if i > 0 { content = content + chr(10) }
        content = content + lines.get(i)
        i += 1
    }
    return writeText(path, content)
}

object Console {
    fun readLine() -> str { return this.readLineOptional().getOrElse("") }
    fun readLineOptional() -> Optional<str> {
        var c = syscall(0)
        if c < 0 { return optionalEmpty<str>() }
        var line = ""
        while c >= 0 && c != 10 { line = line + chr(c); c = syscall(0) }
        val size = strlen(line)
        if c == 10 && size > 0 && strchar(line, size - 1) == 13 {
            line = strslice(line, 0, size - 1)
        }
        return optionalValue<str>(line)
    }
    fun readAll() -> str {
        var out = ""
        var c = syscall(0)
        while c >= 0 { out = out + chr(c); c = syscall(0) }
        return out
    }
    fun print(value: str) -> unit { write(value) }
    fun println(value: str) -> unit { write(value); write(chr(10)) }
}

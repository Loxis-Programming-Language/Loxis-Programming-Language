package loxis.io

import loxis.fileio
import loxis.option

fun __loxis_readChar() -> int { return syscall(0) }
fun __loxis_writeChar(c: int) -> unit {
    require(c >= 0 && c <= 255, "byte out of range")
    write(chr(c))
}

// LF terminates a line; an immediately preceding CR is removed.
// EOF is Empty, while a blank line is Value("").
fun __loxis_readLineOptional() -> Optional<str> {
    var c = __loxis_readChar()
    if c < 0 { return __loxis_optionalEmpty<str>() }
    var line = ""
    while c >= 0 && c != 10 {
        line = line + chr(c)
        c = __loxis_readChar()
    }
    val n = strlen(line)
    if c == 10 && n > 0 && strchar(line, n - 1) == 13 {
        line = strslice(line, 0, n - 1)
    }
    return __loxis_optionalValue<str>(line)
}


fun __loxis_readLines() -> list<str> {
    val out = __loxis_listWithCapacity<str>(8)
    var item = __loxis_readLineOptional()
    while __loxis_optionalHasValue<str>(item) {
        out.push(__loxis_optionalValueOrFail<str>(item))
        item = __loxis_readLineOptional()
    }
    return out
}


fun __loxis_readLines(path: str) -> list<str> {
    val content = __loxis_readText(path)
    val out = __loxis_listWithCapacity<str>(8)
    var start = 0
    var i = 0
    while i < strlen(content) {
        if strchar(content, i) == 10 {
            var end = i
            if end > start && strchar(content, end - 1) == 13 { end -= 1 }
            out.push(strslice(content, start, end - start))
            start = i + 1
        }
        i += 1
    }
    if start < i { out.push(strslice(content, start, i - start)) }
    return out
}

fun __loxis_writeLines(path: str, lines: list<str>) -> int {
    var content = ""
    var i = 0
    while i < lines.size() {
        if i > 0 { content = content + chr(10) }
        content = content + lines.get(i)
        i += 1
    }
    return __loxis_writeText(path, content)
}

object Console {
    fun readChar() -> int { return __loxis_readChar() }
    fun writeChar(c: int) -> unit { return __loxis_writeChar(c) }

    fun readLine() -> str { return this.readLineOptional().getOrElse("") }
    fun readLineOptional() -> Optional<str> {
        var c = syscall(0)
        if c < 0 { return __loxis_optionalEmpty<str>() }
        var line = ""
        while c >= 0 && c != 10 { line = line + chr(c); c = syscall(0) }
        val size = strlen(line)
        if c == 10 && size > 0 && strchar(line, size - 1) == 13 {
            line = strslice(line, 0, size - 1)
        }
        return __loxis_optionalValue<str>(line)
    }
    fun readAll() -> str {
        var out = ""
        var c = syscall(0)
        while c >= 0 { out = out + chr(c); c = syscall(0) }
        return out
    }
    fun print(value: str) -> unit { write(value) }
    fun println(value: str) -> unit { write(value); write(chr(10)) }
}

object Lines {
    fun read() -> list<str> { return __loxis_readLines() }
    fun read(path: str) -> list<str> { return __loxis_readLines(path) }
    fun write(path: str, lines: list<str>) -> int { return __loxis_writeLines(path, lines) }
}

package loxis.option

enum class Optional<T> {
    Empty,
    Value(T),
    fun orNull() -> T? { return __loxis_optionalOrNull<T>(this) }

    fun hasValue() -> bool {
        return when (this) { Optional::Value(_) -> true, else -> false }
    }

    fun isEmpty() -> bool { return !this.hasValue() }

    fun getOrElse(fallback: T) -> T {
        return when (this) { Optional::Value(inner) -> inner, else -> fallback }
    }

    fun getOrElseGet(fallback: fun() -> T) -> T {
        return when (this) { Optional::Value(inner) -> inner, else -> fallback() }
    }

    fun valueOrFail() -> T {
        return when (this) { Optional::Value(inner) -> inner, else -> error("missing optional value") }
    }

    fun map<U>(f: fun(T) -> U) -> Optional<U> {
        return when (this) {
            Optional::Value(inner) -> Optional::<U>::Value(f(inner)),
            else -> Optional::<U>::Empty()
        }
    }

    fun flatMap<U>(f: fun(T) -> Optional<U>) -> Optional<U> {
        return when (this) {
            Optional::Value(inner) -> f(inner),
            else -> Optional::<U>::Empty()
        }
    }

}

fun __loxis_optionalValue<T>(value: T) -> Optional<T> {
    return Optional::<T>::Value(value)
}

fun __loxis_optionalEmpty<T>() -> Optional<T> {
    return Optional::<T>::Empty()
}

fun __loxis_optionalHasValue<T>(value: Optional<T>) -> bool {
    return when (value) {
        Optional::Value(_) -> true,
        else -> false
    }
}

fun __loxis_optionalIsEmpty<T>(value: Optional<T>) -> bool {
    return when (value) {
        Optional::Empty() -> true,
        else -> false
    }
}

fun __loxis_optionalMap<T, U>(value: Optional<T>, f: fun(T) -> U) -> Optional<U> {
    return when (value) {
        Optional::Value(inner) -> Optional::<U>::Value(f(inner)),
        else -> Optional::<U>::Empty()
    }
}


fun __loxis_optionalValueOrFail<T>(value: Optional<T>) -> T {
    return when (value) {
        Optional::Value(inner) -> inner,
        else -> error("missing optional value")
    }
}


fun __loxis_optionalOrNull<T>(value: Optional<T>) -> T? {
    return when (value) {
        Optional::Value(inner) -> inner,
        else -> null
    }
}

object Option {
    fun some<T>(value: T) -> Optional<T> { return Optional::<T>::Value(value) }
    fun none<T>() -> Optional<T> { return Optional::<T>::Empty() }
    fun fromNullable<T>(value: T?) -> Optional<T> {
        if value == null { return Optional::<T>::Empty() }
        return Optional::<T>::Value(value!!)
    }
}

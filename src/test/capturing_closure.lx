import loxis.collections.list
import loxis.functional

fun main() -> int {
    val base = 10
    val addBase: fun(int) -> int = { x -> x + base }
    print(addBase(5))

    val values = listWithCapacity<int>(2)
    values.push(1)
    values.push(3)

    val mapped = values.map<int>({ x -> x + base })
    print(mapped.get(0))
    print(mapped.get(1))

    val factor = 2
    print(values.fold<int>(1, { acc, x -> acc * (x + factor) }))
    print(apply<int, int>({ x -> x + factor }, 8))

    return 0
}

import loxis.io
fun main() -> int {
    val content = Console.readAll()
    require(strlen(content) == 6, "stdin byte count")
    require(strchar(content, 0) == 13 && strchar(content, 1) == 10, "stdin crlf")
    require(strchar(content, 2) == 0 && strchar(content, 3) == 26, "stdin controls")
    require(strchar(content, 5) == 255, "stdin high byte")
    writeChar(65)
    print(" readall ok")
    return 0
}

import loxis.fileio
import loxis.text

fun main() -> int {
    val path = "loxis_fileio_smoke.tmp"
    print(File.writeText(path, "hello").getOrElseGet({ reason -> error(reason) }))
    print(File.appendText(path, "-std").getOrElseGet({ reason -> error(reason) }))
    print(File.appendText(path, "lib").getOrElseGet({ reason -> error(reason) }))

    val content = File.readText(path).getOrElseGet({ reason -> error(reason) })
    print((content).length())
    print((content).indexOf("std"))
    print(content)
    print(File.remove(path))
    return 0
}

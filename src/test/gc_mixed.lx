// GC mixed probe: 70% short-lived trees, 20% retained-list prepends (real
// liveness that grows), 10% two-node cycles. Deterministic LCG so every run
// and every backend sees the identical object stream.
class Node(var left: Node?, var right: Node?, var next: Node?, var tag: int)

fun leaf(tag: int) -> Node {
    return Node(null, null, null, tag)
}

fun tree(depth: int, tag: int) -> Node {
    if depth == 0 {
        return leaf(tag)
    }
    return Node(tree(depth - 1, tag), tree(depth - 1, tag), null, tag)
}

fun main() -> int {
    var seed = 12345
    var head = leaf(0)
    var i = 0
    var sum = 0
    var kept = 0
    while i < 20000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        val roll = seed % 10
        if roll < 7 {
            val t = tree(3, i)
            sum = sum + t.tag
        } else if roll < 9 {
            val n = leaf(i)
            n.next = head
            head = n
            kept += 1
        } else {
            val a = leaf(i)
            val b = leaf(i)
            a.next = b
            b.next = a
        }
        i += 1
    }
    print(sum)
    print(kept)
    return 0
}

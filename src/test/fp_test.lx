import loxis.text
fun main(): void {
    // int to float conversion
    var a = (3).toDouble()
    var b = (4).toDouble()

    // float operations
    var c = ((a) + (b))    // 3.0 + 4.0 = 7.0
    var d = ((c) - (a))    // 7.0 - 3.0 = 4.0
    var e = ((d) * (a))    // 4.0 * 3.0 = 12.0
    var f = ((e) / (b))    // 12.0 / 4.0 = 3.0

    // back to int
    print((c).toInt())        // 7
    print((d).toInt())        // 4
    print((e).toInt())        // 12
    print((f).toInt())        // 3

    // negate
    var g = (-(a))       // -3.0
    print((g).toInt())        // -3
}

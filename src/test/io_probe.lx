package test
import loxis.text
import loxis.fileio

import loxis.io

fun main() -> int {
    var content = Text.fromByte(97) + Text.fromByte(98) + Text.fromByte(10) + Text.fromByte(99) + Text.fromByte(100)
    File.writeText("_t.txt", content).getOrElseGet({ reason -> error(reason) })

    val lines = Lines.read("_t.txt")
    print(lines.size())
    print(lines.get(0))
    print(lines.get(1))
    File.remove("_t.txt")
    return 0
}

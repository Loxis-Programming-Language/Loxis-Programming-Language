import loxis.collections.list

fun main() -> int {
    val xs = listWithCapacity<int>(4)
    xs.push(3)
    xs.push(1)
    xs.push(4)
    xs.push(2)

    xs.sortBy({ a, b -> a < b })
    print(xs.get(0))
    print(xs.get(3))

    xs.reverse()
    print(xs.get(0) * 10 + xs.get(3))

    val ys = xs.reversed()
    print(ys.get(0) * 10 + ys.get(3))

    val zs = xs.append(ys)
    print(zs.size())
    print(zs.get(0) + zs.get(7))

    listFree<int>(zs)
    listFree<int>(ys)
    listFree<int>(xs)
    return 0
}

import loxis.collections.list

fun main() -> int {
    val xs = listWithCapacity<int>(4)
    xs.push(2)
    xs.push(4)
    xs.push(6)
    xs.push(8)

    print(xs.fold<int>(0, { acc: int, x: int -> acc + x }))
    print(xs.fold<int>(1, { acc, x -> acc * x }))
    print(xs.count({ x -> x > 4 }))

    if xs.any({ x -> x == 6 }) {
        print(1)
    } else {
        print(0)
    }

    if xs.all({ x -> x < 10 }) {
        print(1)
    } else {
        print(0)
    }

    listFree<int>(xs)
    return 0
}

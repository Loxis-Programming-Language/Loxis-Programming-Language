fun add(a: int, b: int): int {
    return a + b
}

fun main(): void {
    val x = 42              // val preferred
    var y = 100             // var for mutable
    y = add(x, y)           // reassign ok
    print(y)

    // x = 99               // would error: x is val
    // z = 10               // would error: use val or var
}

import loxis.text
fun main(): void {
    // int + int → int
    print(10 + 20)

    // double + double → double
    var a = 3.0 + 4.0
    print((a).toInt())

    // double * double
    var b = 2.5 * 2.0
    print((b).toInt())

    // int + double → auto-promote
    var c = 3 + 4.0
    print((c).toInt())

    // double / double
    var d = 10.0 / 3.0
    print((d).toInt())

    // float literal
    var e = 3f + 4f
    print((e).toInt())

    // mixed expression
    var f = 1.5 + 2.5 * 2.0
    print((f).toInt())
}

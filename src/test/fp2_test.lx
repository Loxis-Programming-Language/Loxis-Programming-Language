import loxis.text
fun main(): void {
    // float literal
    var a = 3.0
    var b = 4.0
    var c = ((a) + (b))    // 7.0
    print((c).toInt())

    // double literal with fraction
    var d = 2.5
    var e = ((d) + (d))    // 5.0
    print((e).toInt())

    // float suffix
    var f = 3f
    var g = 2f
    var h = ((f) + (g))    // 5.0
    print((h).toInt())
}

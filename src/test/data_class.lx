data class User(val id: int, val name: str)

fun main() {
    val ada = User(1, "Ada")
    val copy = ada.copy(2, "Grace")
    print(ada.component1())
    print(ada.component2())
    print(copy.id)
    print(copy.name)
    print(ada.equals(User(1, "Ada")))
    print(ada == User(1, "Ada"))
    print(ada.hashCode())
    print(ada.toString())
}

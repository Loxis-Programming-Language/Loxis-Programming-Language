data class Point(val x: int, val y: int)

fun main() -> int {
    val p = Point(2, 3)
    val same = p.copy(2, 3)
    val moved = p.copy(5, 7)

    print(p.component1())
    print(p.component2())
    print(p == same)
    print(p == moved)
    print(p.equals(same))
    print(p.hashCode())
    print(p.toString())
    print(moved.x * 10 + moved.y)
    return 0
}

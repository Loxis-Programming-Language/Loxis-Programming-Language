data class User(val id: int, val name: str)
data class Flags(val enabled: bool, val marker: char, val ratio: double)

fun main() {
    val ada = User(1, "Ada")
    val copy = ada.copy(2, "Grace")
    print(ada.component1())
    print(ada.component2())
    print(copy.id)
    print(copy.name)
    print(ada.equals(User(1, "Ada")))
    print(ada == User(1, "Ada"))
    print(ada.hashCode())
    print(ada.toString())
    val flags = Flags(true, 'A', 1.5)
    print(flags == Flags(true, 'A', 1.5))
    print(flags.hashCode())
    print(flags.toString())
}

class CtorSmokePoint {
    var x: int = 10
    var y: int = 20

    fun move(dx: int, dy: int) -> unit {
        this.x += dx
        this.y += dy
    }
}

fun main() -> int {
    val p = CtorSmokePoint_new()
    print(p.x)
    print(p.y)
    p.move(5, 3)
    print(p.x)
    print(p.y)
    return 0
}

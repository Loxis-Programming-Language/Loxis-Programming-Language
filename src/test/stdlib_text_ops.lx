import loxis.text

fun main() -> int {
    val value = concat("loxis", "-stdlib")
    print(len(value))
    print(charCodeAt(value, 0))
    print(slice(value, 2, 3))
    print(indexOf(value, "std"))

    if contains(value, "lib") {
        print(1)
    } else {
        print(0)
    }

    if contains(value, "missing") {
        print(1)
    } else {
        print(0)
    }

    print(slice(value, 100, 2))
    return 0
}

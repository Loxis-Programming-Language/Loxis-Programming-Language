import loxis.text

fun main() -> int {
    val value = (("loxis") + ("-stdlib"))
    print((value).length())
    print((value).byteAt(0))
    print((value).slice(2, 3))
    print((value).indexOf("std"))

    if (value).contains("lib") {
        print(1)
    } else {
        print(0)
    }

    if (value).contains("missing") {
        print(1)
    } else {
        print(0)
    }

    print((value).slice(100, 2))
    return 0
}

import loxis.option
import loxis.result

fun inc(x: int) -> int {
    return x + 1
}

fun keepEven(x: int) -> Optional<int> {
    if x == 4 {
        return Option.some<int>(40)
    }
    return Option.none<int>()
}

fun resultInc(x: int) -> Result<int, str> {
    return Results.success<int, str>(x + 1)
}

fun main() -> int {
    val optValue = Option.some<int>(3)
    val optEmpty = Option.none<int>()
    val mapped = optValue.map<int>(inc)
    val flatMapped = mapped.flatMap<int>(keepEven)

    print(mapped.getOrElse(0))
    print(optEmpty.getOrElse(7))
    print(flatMapped.getOrElse(0))
    print(optValue.hasValue())
    print(optEmpty.isEmpty())

    val successValue = Results.success<int, str>(10)
    val failureValue = Results.failure<int, str>("bad")
    val resultMapped = successValue.map<int>(inc)
    val resultFlatMapped = resultMapped.flatMap<int>(resultInc)

    print(resultMapped.getOrElse(0))
    print(failureValue.getOrElse(5))
    print(resultFlatMapped.getOrElse(0))
    print(successValue.isSuccess())
    print(failureValue.isFailure())

    return 0
}

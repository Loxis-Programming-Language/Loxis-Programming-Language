import loxis.math
// Enum exhaustiveness for `when` in value position.
//
// Regression: a `when` missing a variant compiled without complaint and fell
// off the end, returning whatever the last matched arm had left behind.
// Statement-position `when` stays permissive, as in Kotlin.
import loxis.text

enum class Shape {
    Circle(int),
    Square(int),
    Point
}

fun area(s: Shape) -> int {
    return when (s) {
        Shape::Circle(r) -> 3 * r * r,
        Shape::Square(w) -> w * w,
        Shape::Point() -> 0
    }
}

fun describe(s: Shape) -> str {
    return when (s) {
        Shape::Point() -> "point",
        else -> "sized"
    }
}

fun log(s: Shape) -> int {
    // A value that is discarded need not be exhaustive.
    when (s) {
        Shape::Point() -> { print("point!") }
    }
    return 0
}

fun main() -> int {
    print("${area(Shape::Circle(2))} ${area(Shape::Square(3))} ${area(Shape::Point())}")
    print(describe(Shape::Circle(1)))
    print(describe(Shape::Point()))
    log(Shape::Circle(1))
    log(Shape::Point())
    return 0
}

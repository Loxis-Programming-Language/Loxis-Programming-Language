import loxis.collections.list

fun main() -> int {
    val xs = Lists.withCapacity<int>(2)
    xs.push(1)
    xs.push(2)
    xs.push(3)
    xs.push(4)

    val mapped = xs.map<int>({ x -> x * 10 })
    print(mapped.size())
    print(mapped.get(0) + mapped.get(3))

    val filtered = mapped.filter({ x -> x > 20 })
    print(filtered.size())
    print(filtered.get(0) + filtered.get(1))

    filtered.forEach({ x -> print(x) })
    return 0
}

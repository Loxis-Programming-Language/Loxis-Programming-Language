fun overriddenReturn() -> int {
    try {
        return 1
    } finally {
        return 2
    }
}

fun main() -> int {
    print(overriddenReturn())
    var i = 0
    while i < 4 {
        i = i + 1
        try {
            if i == 2 { continue }
            if i == 3 { break }
            print(i)
        } finally {
            print(100 + i)
        }
    }
    print(i)
    return 0
}

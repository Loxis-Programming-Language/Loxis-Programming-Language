import loxis.collections.list
import loxis.collections.stream

fun main() -> int {
    var xs = Lists.withCapacity<int>(4)
    xs.push(10)
    xs.push(20)
    xs.push(30)

    var pipeline = stream<int>(xs)
    print(pipeline.count())

    var ys = stream<int>(xs).toList()
    print(ys.size())
    print(ys.get(1))
    return 0
}
